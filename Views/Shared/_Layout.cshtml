<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Sales Web MVC</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Sales Web MVC</a>
            </div>
            <ul class="nav navbar-nav">
                <li><a asp-controller="Sellers" asp-action="Index">Sellers</a></li>
                <li><a asp-controller="Departments" asp-action="Index">Departaments</a></li>
                <li><a asp-controller="SalesRecords" asp-action="Index">Sales</a></li>
            </ul>
        </div>
    </nav>

    <div class="container" style="margin-top:70px;">
        @RenderBody()
    </div>

    <footer class="footer">
        <div class="container text-center">
            <p class="text-muted">© 2025 Sales Web MVC</p>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.3.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
