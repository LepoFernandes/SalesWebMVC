@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron text-center">
    <h1>Bem-vindo ao Sales Web MVC</h1>
    <p>Gerencie vendedores, departamentos e registros de vendas facilmente.</p>
    <hr>
    <p>Escolha uma das opções abaixo para começar:</p>

    <div class="row text-center" style="margin-top:50px;">
        <div class="col-md-4 col-md-offset-2" style="margin-bottom:20px;">
            <a class="btn btn-primary btn-lg btn-block" asp-controller="Sellers" asp-action="Index">
                👨‍💼 Sellers
            </a>
        </div>
        <div class="col-md-4" style="margin-bottom:20px;">
            <a class="btn btn-success btn-lg btn-block" asp-controller="Departments" asp-action="Index">
                🏢 Departaments
            </a>
        </div>
    </div>

    <div class="row text-center">
        <div class="col-md-4 col-md-offset-4">
            <a class="btn btn-info btn-lg btn-block" asp-controller="SalesRecords" asp-action="Index">
                📊 Sales
            </a>
        </div>
    </div>
</div>
